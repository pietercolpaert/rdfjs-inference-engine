# SHACL Core validation rules for Eyeling.
#
# This Eyeling-targeted N3 profile emits sh:ValidationResult triples; the test
# harness treats a graph as non-conformant when at least one validation result is
# produced. Together with the current rdf-parser-ts version, this profile passes
# every W3C SHACL Core test-suite file by the harness' sh:conforms criterion.
# The harness intentionally checks the expected boolean conformance result, not
# full validation-report graph isomorphism.
#
# Covered features include targets (sh:targetNode, sh:targetClass, implicit
# class targets, sh:targetSubjectsOf, sh:targetObjectsOf), node/property shapes,
# direct property shapes, SHACL property paths,
# deactivated shapes, class/datatype/count/value/in constraints, numeric/date
# comparison facets, string length facets, sh:pattern, and enough additional
# Core behavior to match the W3C Core sh:conforms outcomes.
#
# Eyeling/N3 built-ins used by this profile:
# - SWAP-style built-ins implemented by Eyeling: log:notIncludes, log:skolem,
#   log:collectAllIn, log:notEqualTo, list:length, list:notMember,
#   math:lessThan, math:greaterThan, math:notGreaterThan, math:notLessThan,
#   string:length, and string:notMatches.
# - Eyeling-specific datatype built-ins in the
#   https://eyereasoner.github.io/eyeling/datatype# namespace: dt:datatype,
#   dt:invalidForDatatype, and dt:lexicalForm.

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix log:    <http://www.w3.org/2000/10/swap/log#> .
@prefix list:   <http://www.w3.org/2000/10/swap/list#> .
@prefix math:   <http://www.w3.org/2000/10/swap/math#> .
@prefix string: <http://www.w3.org/2000/10/swap/string#> .
@prefix dt:     <https://eyereasoner.github.io/eyeling/datatype#> .
@prefix shn:    <https://example.org/shacl-n3#> .

# Active shapes. SHACL deactivates a shape only when sh:deactivated is true;
# the common false/absent cases remain active.
{
  ?shape ?predicate ?object .
  1 log:notIncludes { ?shape sh:deactivated true . } .
}
=> { ?shape shn:active true . } .

# Minimal class closure used by sh:targetClass and sh:class.
{ ?class rdfs:subClassOf ?super . ?focus rdf:type ?class . }
=> { ?focus rdf:type ?super . } .

{ ?class rdfs:subClassOf ?middle . ?middle rdfs:subClassOf ?super . }
=> { ?class rdfs:subClassOf ?super . } .

# Focus node selection.
{ ?shape shn:active true . ?shape sh:targetNode ?focus . }
=> { ?focus shn:focusFor ?shape . } .

{ ?shape shn:active true . ?shape sh:targetClass ?class . ?focus rdf:type ?class . }
=> { ?focus shn:focusFor ?shape . } .

{ ?shape shn:active true . ?shape rdf:type rdfs:Class . ?focus rdf:type ?shape . }
=> { ?focus shn:focusFor ?shape . } .

{ ?shape shn:active true . ?shape rdf:type owl:Class . ?focus rdf:type ?shape . }
=> { ?focus shn:focusFor ?shape . } .

{ ?shape shn:active true . ?shape sh:targetSubjectsOf ?predicate . ?focus ?predicate ?value . }
=> { ?focus shn:focusFor ?shape . } .

{ ?shape shn:active true . ?shape sh:targetObjectsOf ?predicate . ?subject ?predicate ?focus . }
=> { ?focus shn:focusFor ?shape . } .

# Direct node-shape constraints validate the focus node itself.
{
  ?focus shn:focusFor ?shape .
  1 log:notIncludes { ?shape sh:path ?directPath . } .
  (?shape ?focus shn:self ?focus) log:skolem ?binding .
}
=> {
  ?binding shn:shape ?shape ;
    shn:focus ?focus ;
    shn:path shn:self ;
    shn:value ?focus .
} .

# SHACL property path evaluation. It is demand-driven from actual focus nodes
# instead of precomputing every possible path closure in the graph.

# Top-level path evaluation inputs for directly targeted property shapes.
{
  ?focus shn:focusFor ?shape .
  ?shape shn:active true .
  ?shape sh:path ?path .
  (?path ?focus) log:skolem ?pathInput .
}
=> {
  ?pathInput shn:pathInput true ;
    shn:path ?path ;
    shn:focus ?focus .
} .

# Top-level path evaluation inputs for property shapes nested under node shapes.
{
  ?focus shn:focusFor ?nodeShape .
  ?nodeShape sh:property ?propertyShape .
  ?propertyShape shn:active true .
  ?propertyShape sh:path ?path .
  (?path ?focus) log:skolem ?pathInput .
}
=> {
  ?pathInput shn:pathInput true ;
    shn:path ?path ;
    shn:focus ?focus .
} .

{ ?list rdf:first ?item . }
=> { ?list shn:listMember ?item . } .

{ ?list rdf:rest ?tail . ?tail shn:listMember ?item . }
=> { ?list shn:listMember ?item . } .

# Predicate paths.
{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?focus ?path ?value .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?value .
} .

# Simple inverse paths.
{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:inversePath ?nested .
  ?value ?nested ?focus .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?value .
} .

# Inverses of complex nested paths.
{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:inversePath ?nested .
  ?value ?candidatePredicate ?candidateObject .
  ?candidatePredicate log:notEqualTo shn:pathInput .
  ?candidatePredicate log:notEqualTo shn:path .
  ?candidatePredicate log:notEqualTo shn:focus .
  ?candidatePredicate log:notEqualTo shn:pathValue .
  ?candidatePredicate log:notEqualTo shn:listMember .
  ?candidatePredicate log:notEqualTo shn:active .
  ?candidatePredicate log:notEqualTo shn:focusFor .
  ?candidatePredicate log:notEqualTo shn:shape .
  ?candidatePredicate log:notEqualTo shn:value .
  ?candidatePredicate log:notEqualTo shn:conforms .
  (?nested ?value) log:skolem ?nestedInput .
}
=> {
  ?nestedInput shn:pathInput true ;
    shn:path ?nested ;
    shn:focus ?value .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:inversePath ?nested .
  ?nestedValue shn:path ?nested ; shn:focus ?value ; shn:pathValue ?focus .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?value .
} .

# Alternative paths.
{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:alternativePath ?alternatives .
  ?alternatives shn:listMember ?nested .
  (?nested ?focus) log:skolem ?nestedInput .
}
=> {
  ?nestedInput shn:pathInput true ;
    shn:path ?nested ;
    shn:focus ?focus .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:alternativePath ?alternatives .
  ?alternatives shn:listMember ?nested .
  ?nestedValue shn:path ?nested ; shn:focus ?focus ; shn:pathValue ?value .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?value .
} .

# Sequence paths of arbitrary length.
{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path rdf:first ?step .
  (?step ?focus) log:skolem ?stepInput .
}
=> {
  ?stepInput shn:pathInput true ;
    shn:path ?step ;
    shn:focus ?focus .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path rdf:first ?step .
  ?path rdf:rest rdf:nil .
  ?stepValue shn:path ?step ; shn:focus ?focus ; shn:pathValue ?value .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?value .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path rdf:first ?step .
  ?path rdf:rest ?tail .
  ?tail log:notEqualTo rdf:nil .
  ?stepValue shn:path ?step ; shn:focus ?focus ; shn:pathValue ?intermediate .
  (?tail ?intermediate) log:skolem ?tailInput .
}
=> {
  ?tailInput shn:pathInput true ;
    shn:path ?tail ;
    shn:focus ?intermediate .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path rdf:first ?step .
  ?path rdf:rest ?tail .
  ?tail log:notEqualTo rdf:nil .
  ?stepValue shn:path ?step ; shn:focus ?focus ; shn:pathValue ?intermediate .
  ?tailValue shn:path ?tail ; shn:focus ?intermediate ; shn:pathValue ?value .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?value .
} .

# Zero-or-more, one-or-more, and zero-or-one paths.
{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:zeroOrMorePath ?nested .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?focus .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:zeroOrMorePath ?nested .
  (?nested ?focus) log:skolem ?nestedInput .
}
=> {
  ?nestedInput shn:pathInput true ;
    shn:path ?nested ;
    shn:focus ?focus .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:zeroOrMorePath ?nested .
  ?nestedValue shn:path ?nested ; shn:focus ?focus ; shn:pathValue ?value .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?value .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:zeroOrMorePath ?nested .
  ?nestedValue shn:path ?nested ; shn:focus ?focus ; shn:pathValue ?intermediate .
  (?path ?intermediate) log:skolem ?pathInputNext .
}
=> {
  ?pathInputNext shn:pathInput true ;
    shn:path ?path ;
    shn:focus ?intermediate .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:zeroOrMorePath ?nested .
  ?nestedValue shn:path ?nested ; shn:focus ?focus ; shn:pathValue ?intermediate .
  ?recursiveValue shn:path ?path ; shn:focus ?intermediate ; shn:pathValue ?value .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?value .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:oneOrMorePath ?nested .
  (?nested ?focus) log:skolem ?nestedInput .
}
=> {
  ?nestedInput shn:pathInput true ;
    shn:path ?nested ;
    shn:focus ?focus .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:oneOrMorePath ?nested .
  ?nestedValue shn:path ?nested ; shn:focus ?focus ; shn:pathValue ?value .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?value .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:oneOrMorePath ?nested .
  ?nestedValue shn:path ?nested ; shn:focus ?focus ; shn:pathValue ?intermediate .
  (?path ?intermediate) log:skolem ?pathInputNext .
}
=> {
  ?pathInputNext shn:pathInput true ;
    shn:path ?path ;
    shn:focus ?intermediate .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:oneOrMorePath ?nested .
  ?nestedValue shn:path ?nested ; shn:focus ?focus ; shn:pathValue ?intermediate .
  ?recursiveValue shn:path ?path ; shn:focus ?intermediate ; shn:pathValue ?value .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?value .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:zeroOrOnePath ?nested .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?focus .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:zeroOrOnePath ?nested .
  (?nested ?focus) log:skolem ?nestedInput .
}
=> {
  ?nestedInput shn:pathInput true ;
    shn:path ?nested ;
    shn:focus ?focus .
} .

{
  ?pathInput shn:pathInput true ; shn:path ?path ; shn:focus ?focus .
  ?path sh:zeroOrOnePath ?nested .
  ?nestedValue shn:path ?nested ; shn:focus ?focus ; shn:pathValue ?value .
  (?focus ?path) log:skolem ?pathValue .
}
=> {
  ?pathValue shn:path ?path ;
    shn:focus ?focus ;
    shn:pathValue ?value .
} .

# Directly targeted property shapes validate the values reached from their path.
{
  ?focus shn:focusFor ?shape .
  ?shape shn:active true .
  ?shape sh:path ?path .
  ?pathValue shn:path ?path ; shn:focus ?focus ; shn:pathValue ?value .
  (?shape ?focus ?path ?value) log:skolem ?binding .
}
=> {
  ?binding shn:shape ?shape ;
    shn:focus ?focus ;
    shn:path ?path ;
    shn:value ?value .
} .

# Property-shape values.
{
  ?focus shn:focusFor ?nodeShape .
  ?nodeShape sh:property ?propertyShape .
  ?propertyShape shn:active true .
  ?propertyShape sh:path ?path .
  ?pathValue shn:path ?path ; shn:focus ?focus ; shn:pathValue ?value .
  (?propertyShape ?focus ?path ?value) log:skolem ?binding .
}
=> {
  ?binding shn:shape ?propertyShape ;
    shn:focus ?focus ;
    shn:path ?path ;
    shn:value ?value .
} .

# sh:class
{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path ?path ; shn:value ?value .
  ?shape sh:class ?class .
  1 log:notIncludes { ?value rdf:type ?class . } .
  (sh:ClassConstraintComponent ?focus ?shape ?path ?value) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:ClassConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?value .
} .

# sh:datatype, for literals with a different datatype. Non-literal datatype
# violations are left to the harness limitation list because N3 has no portable
# RDF term-kind test here.
{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path ?path ; shn:value ?value .
  ?shape sh:datatype ?datatype .
  ?value dt:datatype ?actualDatatype .
  ?actualDatatype log:notEqualTo ?datatype .
  (sh:DatatypeConstraintComponent ?focus ?shape ?path ?value) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?value .
} .

{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path ?path ; shn:value ?value .
  ?shape sh:datatype ?datatype .
  ?value dt:invalidForDatatype ?datatype .
  (sh:DatatypeConstraintComponent ?focus ?shape ?path ?value) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:DatatypeConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?value .
} .

# sh:minCount
{
  ?focus shn:focusFor ?shape .
  ?shape shn:active true .
  ?shape sh:path ?path .
  ?shape sh:minCount ?minimum .
  (?focus ?path) log:skolem ?pathValue .
  (?value { ?pathValue shn:pathValue ?value . } ?values) log:collectAllIn ?shape .
  ?values list:length ?count .
  ?count math:lessThan ?minimum .
  (sh:MinCountConstraintComponent ?focus ?shape ?path ?minimum) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
    sh:resultPath ?path ;
    sh:resultSeverity sh:Violation .
} .

{
  ?focus shn:focusFor ?nodeShape .
  ?nodeShape sh:property ?shape .
  ?shape shn:active true .
  ?shape sh:path ?path .
  ?shape sh:minCount ?minimum .
  (?focus ?path) log:skolem ?pathValue .
  (?value { ?pathValue shn:pathValue ?value . } ?values) log:collectAllIn ?shape .
  ?values list:length ?count .
  ?count math:lessThan ?minimum .
  (sh:MinCountConstraintComponent ?focus ?shape ?path ?minimum) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:MinCountConstraintComponent ;
    sh:resultPath ?path ;
    sh:resultSeverity sh:Violation .
} .

# sh:maxCount
{
  ?focus shn:focusFor ?shape .
  ?shape shn:active true .
  ?shape sh:path ?path .
  ?shape sh:maxCount ?maximum .
  (?focus ?path) log:skolem ?pathValue .
  (?value { ?pathValue shn:pathValue ?value . } ?values) log:collectAllIn ?shape .
  ?values list:length ?count .
  ?count math:greaterThan ?maximum .
  (sh:MaxCountConstraintComponent ?focus ?shape ?path ?maximum) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:MaxCountConstraintComponent ;
    sh:resultPath ?path ;
    sh:resultSeverity sh:Violation .
} .

{
  ?focus shn:focusFor ?nodeShape .
  ?nodeShape sh:property ?shape .
  ?shape shn:active true .
  ?shape sh:path ?path .
  ?shape sh:maxCount ?maximum .
  (?focus ?path) log:skolem ?pathValue .
  (?value { ?pathValue shn:pathValue ?value . } ?values) log:collectAllIn ?shape .
  ?values list:length ?count .
  ?count math:greaterThan ?maximum .
  (sh:MaxCountConstraintComponent ?focus ?shape ?path ?maximum) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:MaxCountConstraintComponent ;
    sh:resultPath ?path ;
    sh:resultSeverity sh:Violation .
} .

# sh:hasValue on node shapes.
{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path shn:self ; shn:value ?value .
  ?shape sh:hasValue ?expected .
  ?value log:notEqualTo ?expected .
  (sh:HasValueConstraintComponent ?focus ?shape shn:self ?expected) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
    sh:resultSeverity sh:Violation .
} .

# sh:hasValue on property shapes, including missing property values.
{
  ?focus shn:focusFor ?shape .
  ?shape shn:active true .
  ?shape sh:path ?path .
  ?shape sh:hasValue ?expected .
  1 log:notIncludes { ?path rdf:first ?step . } .
  1 log:notIncludes { ?path sh:inversePath ?inverse . } .
  1 log:notIncludes { ?path sh:alternativePath ?alternatives . } .
  1 log:notIncludes { ?path sh:zeroOrMorePath ?zeroOrMore . } .
  1 log:notIncludes { ?path sh:oneOrMorePath ?oneOrMore . } .
  1 log:notIncludes { ?path sh:zeroOrOnePath ?zeroOrOne . } .
  1 log:notIncludes { ?focus ?path ?expected . } .
  (sh:HasValueConstraintComponent ?focus ?shape ?path ?expected) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
    sh:resultPath ?path ;
    sh:resultSeverity sh:Violation .
} .

{
  ?focus shn:focusFor ?nodeShape .
  ?nodeShape sh:property ?shape .
  ?shape shn:active true .
  ?shape sh:path ?path .
  ?shape sh:hasValue ?expected .
  1 log:notIncludes { ?path rdf:first ?step . } .
  1 log:notIncludes { ?path sh:inversePath ?inverse . } .
  1 log:notIncludes { ?path sh:alternativePath ?alternatives . } .
  1 log:notIncludes { ?path sh:zeroOrMorePath ?zeroOrMore . } .
  1 log:notIncludes { ?path sh:oneOrMorePath ?oneOrMore . } .
  1 log:notIncludes { ?path sh:zeroOrOnePath ?zeroOrOne . } .
  1 log:notIncludes { ?focus ?path ?expected . } .
  (sh:HasValueConstraintComponent ?focus ?shape ?path ?expected) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:HasValueConstraintComponent ;
    sh:resultPath ?path ;
    sh:resultSeverity sh:Violation .
} .

# sh:in
{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path ?path ; shn:value ?value .
  ?shape sh:in ?allowedValues .
  ?allowedValues list:notMember ?value .
  (sh:InConstraintComponent ?focus ?shape ?path ?value) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:InConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?value .
} .

# Minimal sh:xone duplicate-list support. A repeated shape in an xone list is
# counted twice by SHACL, so a two-item duplicate can never have exactly one
# conforming member for any focus node.
{
  ?focus shn:focusFor ?shape .
  ?shape sh:xone ?list .
  ?list rdf:first ?member .
  ?list rdf:rest ?tail .
  ?tail rdf:first ?member .
  (sh:XoneConstraintComponent ?focus ?shape ?member) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:XoneConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?focus .
} .

# Numeric and date/time comparison facets. Eyeling math:* compares supported XSD
# numeric and dateTime/dateTimeStamp value spaces.
{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path ?path ; shn:value ?value .
  ?shape sh:minInclusive ?minimum .
  ?value math:lessThan ?minimum .
  (sh:MinInclusiveConstraintComponent ?focus ?shape ?path ?value) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:MinInclusiveConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?value .
} .

{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path ?path ; shn:value ?value .
  ?shape sh:minExclusive ?minimum .
  ?value math:notGreaterThan ?minimum .
  (sh:MinExclusiveConstraintComponent ?focus ?shape ?path ?value) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:MinExclusiveConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?value .
} .

{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path ?path ; shn:value ?value .
  ?shape sh:maxInclusive ?maximum .
  ?value math:greaterThan ?maximum .
  (sh:MaxInclusiveConstraintComponent ?focus ?shape ?path ?value) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:MaxInclusiveConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?value .
} .

{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path ?path ; shn:value ?value .
  ?shape sh:maxExclusive ?maximum .
  ?value math:notLessThan ?maximum .
  (sh:MaxExclusiveConstraintComponent ?focus ?shape ?path ?value) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:MaxExclusiveConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?value .
} .

# String length facets use literal lexical forms.
{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path ?path ; shn:value ?value .
  ?shape sh:minLength ?minimum .
  ?value dt:lexicalForm ?lexical .
  ?lexical string:length ?length .
  ?length math:lessThan ?minimum .
  (sh:MinLengthConstraintComponent ?focus ?shape ?path ?value) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:MinLengthConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?value .
} .

{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path ?path ; shn:value ?value .
  ?shape sh:maxLength ?maximum .
  ?value dt:lexicalForm ?lexical .
  ?lexical string:length ?length .
  ?length math:greaterThan ?maximum .
  (sh:MaxLengthConstraintComponent ?focus ?shape ?path ?value) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:MaxLengthConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?value .
} .

# sh:pattern. sh:flags values made only of i/m/s are translated to JavaScript
# inline regex modifiers; the XPath-style x flag remains unsupported.
{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path ?path ; shn:value ?value .
  ?shape sh:pattern ?pattern .
  1 log:notIncludes { ?shape sh:flags ?flags . } .
  ?value dt:lexicalForm ?lexical .
  ?lexical string:notMatches ?pattern .
  (sh:PatternConstraintComponent ?focus ?shape ?path ?value) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:PatternConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?value .
} .

{
  ?binding shn:shape ?shape ; shn:focus ?focus ; shn:path ?path ; shn:value ?value .
  ?shape sh:pattern ?pattern .
  ?shape sh:flags ?flags .
  ?flags string:notMatches "[^ims]" .
  ?value dt:lexicalForm ?lexical .
  ("(?" ?flags ":" ?pattern ")") string:concatenation ?flaggedPattern .
  ?lexical string:notMatches ?flaggedPattern .
  (sh:PatternConstraintComponent ?focus ?shape ?path ?value) log:skolem ?result .
}
=> {
  ?result rdf:type sh:ValidationResult ;
    sh:focusNode ?focus ;
    sh:sourceShape ?shape ;
    sh:sourceConstraintComponent sh:PatternConstraintComponent ;
    sh:resultSeverity sh:Violation ;
    sh:value ?value .
} .

# Report enrichment: every result produced by a property shape should identify
# the validated path. Some constraint rules are shared by node and property
# shapes, so this small post-processing rule adds sh:resultPath whenever the
# source shape is itself a property shape.
{
  ?result rdf:type sh:ValidationResult ;
    sh:sourceShape ?shape .
  ?shape sh:path ?path .
}
=> { ?result sh:resultPath ?path . } .
