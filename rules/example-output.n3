# Output-selection rules for the runnable example.
#
# Eyeling's default output would include every newly derived triple, including
# many OWL/RDFS schema-level consequences. These log:query clauses keep the
# example focused on the stream-enrichment results.

@prefix :     <https://example.org/transit#> .
@prefix owlrl:<https://w3id.org/owlrl-n3#> .
@prefix log:  <http://www.w3.org/2000/10/swap/log#> .

{ ?vehicle a :Bus . } log:query { ?vehicle a :Bus . } .
{ ?vehicle a :Vehicle . } log:query { ?vehicle a :Vehicle . } .
{ ?vehicle a :ObservedVehicle . } log:query { ?vehicle a :ObservedVehicle . } .
{ ?vehicle :seenAt ?stop . } log:query { ?vehicle :seenAt ?stop . } .
{ ?vehicle :operatedBy ?operator . } log:query { ?vehicle :operatedBy ?operator . } .
{ ?operator a :Operator . } log:query { ?operator a :Operator . } .
{ ?err a owlrl:Inconsistency . } log:query { ?err a owlrl:Inconsistency . } .
