# SHACL shapes for the validation example.

@prefix ex:   <https://example.org/shacl#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:PersonShape
  a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:property ex:PersonShape-name ;
  sh:property ex:PersonShape-age ;
  sh:property ex:PersonShape-email .

ex:PersonShape-name
  a sh:PropertyShape ;
  sh:path ex:name ;
  sh:minCount 1 ;
  sh:datatype xsd:string .

ex:PersonShape-age
  a sh:PropertyShape ;
  sh:path ex:age ;
  sh:minInclusive 0 ;
  sh:maxInclusive 120 .

ex:PersonShape-email
  a sh:PropertyShape ;
  sh:path ex:email ;
  sh:maxCount 1 ;
  sh:pattern "^[^@]+@[^@]+$" .
