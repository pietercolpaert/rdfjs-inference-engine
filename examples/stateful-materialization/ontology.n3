# Background ontology for the stateful materialization example.

@prefix :    <https://example.org/family#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .

:Female a owl:Class .
:Parent a owl:Class .
:Mother a owl:Class ;
  owl:equivalentClass :FemaleParent .

:FemaleParent owl:intersectionOf :femaleParentClasses .

:femaleParentClasses
  rdf:first :Female ;
  rdf:rest :femaleParentClassesTail .

:femaleParentClassesTail
  rdf:first :Parent ;
  rdf:rest rdf:nil .

:hasParent rdfs:range :Parent .
