@prefix ex: <https://example.org/qudt-temperature#> .
@prefix cdt: <https://w3id.org/cdt/> .

VERSION "1.2-messages"
ex:m1 ex:temperature "0 Cel"^^cdt:temperature .
@message .
ex:m2 ex:temperature "32 local-degF"^^cdt:temperature .
@message .
ex:m3 ex:temperature "300 K"^^cdt:temperature .
@message .
