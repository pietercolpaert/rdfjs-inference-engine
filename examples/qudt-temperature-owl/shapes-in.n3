@prefix ex: <https://example.org/qudt-temperature#> .
@prefix cdt: <https://w3id.org/cdt/> .
@prefix qcr: <https://www.pieter.pm/rdfjs-inference-engine/ns/qudt-inference#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix unit: <http://qudt.org/vocab/unit/> .

ex:TemperatureInputShape a sh:NodeShape ;
  sh:targetSubjectsOf ex:temperature ;
  sh:property [
    sh:path ex:temperature ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype cdt:temperature ;
    qcr:UcumUnitIn ( unit:DEG_C ex:LocalFahrenheit unit:K )
  ] .
