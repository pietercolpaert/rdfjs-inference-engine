@prefix ex: <https://example.org/qudt-temperature#> .
@prefix qcr: <https://w3id.org/qudt-inference#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:TemperatureOutputShape a sh:NodeShape ;
  sh:targetSubjectsOf ex:temperature ;
  sh:property [ sh:path qcr:normalizedQuantity ; sh:minCount 1 ; sh:maxCount 1 ; sh:class qudt:QuantityValue ; sh:unit unit:K ] .

ex:KelvinQuantityShape a sh:NodeShape ;
  sh:targetObjectsOf qcr:normalizedQuantity ;
  sh:property [ sh:path qudt:numericValue ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path qudt:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue unit:K ] .
