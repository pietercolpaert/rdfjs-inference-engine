# RDF input for the SHACL 1.2 + OWL RL grandfather example.

PREFIX ex: <https://example.org/shacl12-grandfather#>

ex:P1 a ex:Person ;
  ex:child ex:P1.1, ex:P1.2 ;
  ex:gender "male" .

ex:P1.1 a ex:Person ;
  ex:child ex:P1.1.1 .

ex:P1.1.1 a ex:Person .

ex:P1.2 a ex:Person ;
  ex:child ex:P1.2.1, ex:P1.2.2 .

ex:P1.2.1 a ex:Person .
ex:P1.2.2 a ex:Person .
