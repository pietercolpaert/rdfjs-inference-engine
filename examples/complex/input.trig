# RDF input for the complex OWL 2 RL example.

PREFIX : <https://example.org/logistics#>

:shipment-1 a :PriorityShipment, :FragileShipment ;
  :contains :box-1 ;
  :destinationCountry :belgium ;
  :handledBy :alice ;
  :trackingCode :tracking-a, :tracking-b .

:belgium a :Country .
:alice :partnerOf :bob .
:box-1 :locatedIn :pallet-1 .
:pallet-1 :locatedIn :warehouse-1 .

:shipment-2 :manifestId :manifest-7 .
:shipment-3 :manifestId :manifest-7 .

:shipment-4 a :RegulatedShipment ;
  :contains :item-9 .
