@prefix : <https://example.org/logistics#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.

:shipment-1 a :ExpressShipment, :Shipment, :CountryDestinationShipment;
    :requiresHandling :carefulHandling;
    :hasPart :box-1.
:alice :handles :shipment-1.
:bob :partnerOf :alice.
:box-1 :locatedIn :warehouse-1.
:tracking-a owl:sameAs :tracking-b.
:shipment-2 owl:sameAs :shipment-3.
:item-9 a :RegulatedItem.
