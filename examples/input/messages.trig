# RDF Message Log input for the example.
#
# Run with:
#   eyeling --rdf --stream-messages \
#     rules/owl2rl-eyeling.n3 \
#     ontologies/transit.n3 \
#     rules/stream-enrichment.n3 \
#     rules/example-output.n3 \
#     examples/input/messages.trig

VERSION "1.2-messages"
PREFIX : <https://example.org/transit#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Message 1: vehicle master-data event. The ontology plus OWL 2 RL rules infer:
#   :bus-42 a :Bus, :Vehicle
#   :operator-7 a :Operator
:bus-42 a :ElectricBus ;
  :operatedBy :operator-7 ;
  :seatCount "01"^^xsd:int ;
  :reportedAt "2026-06-10T12:00:00Z"^^xsd:dateTime .

MESSAGE

# Message 2: observation event. The stream rule derives:
#   :bus-42 a :ObservedVehicle
#   :bus-42 :seenAt :stop-12
# and OWL 2 RL infers :bus-42 a :Vehicle from the ObservedVehicle superclass.
:obs-9001 a :VehicleObservation ;
  :observedVehicle :bus-42 ;
  :observedAt :stop-12 ;
  :reportedAt "2026-06-10T14:00:00+02:00"^^xsd:dateTime .
