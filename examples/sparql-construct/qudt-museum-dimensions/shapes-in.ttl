@prefix museum: <https://example.org/museum/ontology#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

museum:ProviderShape a sh:NodeShape ;
  sh:targetClass museum:RecordedHeight ;
  sh:property [ sh:path museum:heightOf ; sh:minCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path qudt:numericValue ; sh:minCount 1 ; sh:datatype xsd:decimal ] ;
  sh:property [ sh:path qudt:unit ; sh:minCount 1 ; sh:in (unit:CentiM unit:MilliM unit:M) ] .
