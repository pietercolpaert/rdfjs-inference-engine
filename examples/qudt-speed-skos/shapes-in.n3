@prefix ex: <https://example.org/qudt-speed-skos#> .
@prefix cdt: <https://w3id.org/cdt/> .
@prefix qcr: <https://www.pieter.pm/rdfjs-inference-engine/ns/qudt-inference#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:LocalSpeedInputShape a sh:NodeShape ;
  sh:targetSubjectsOf ex:speed ;
  sh:property [
    sh:path ex:speed ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:datatype cdt:speed ;
    qcr:UcumUnitIn ( ex:LocalKmh ex:LocalMph ex:LocalKnot )
  ] .
