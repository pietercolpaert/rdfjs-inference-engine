{
  "name": "rdfjs-inference-engine",
  "version": "0.1.3",
  "description": "RDF-JS inference engine for generated Eyeling runtimes and N3 rule profiles.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "browser": "browser/rdfjs-inference-engine.min.js",
  "unpkg": "browser/rdfjs-inference-engine.min.js",
  "jsdelivr": "browser/rdfjs-inference-engine.min.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/",
    "browser/",
    "rules/*.n3",
    "index.html",
    "README.md"
  ],
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean --silent && tsc -p tsconfig.json && npm run build:browser --silent",
    "build:node": "npm run clean --silent && tsc -p tsconfig.json",
    "build:browser": "node scripts/build-browser.mjs",
    "hooks:install": "node scripts/install-hooks.cjs",
    "prepare": "node scripts/install-hooks.cjs",
    "example": "npm run example:transit-fleet",
    "example:transit-fleet": "npm run build --silent && node dist/examples/transit-fleet/run.js",
    "example:shipment-logistics": "npm run build --silent && node dist/examples/shipment-logistics/run.js",
    "example:skos-taxonomy": "npm run build --silent && node dist/examples/skos-taxonomy/run.js",
    "example:owl-skos-catalog": "npm run build --silent && node dist/examples/owl-skos-catalog/run.js",
    "example:complex-path-coverage": "npm run build --silent && node dist/examples/complex-path-coverage/run.js",
    "example:shacl-validation": "npm run build --silent && node dist/examples/shacl-validation/run.js",
    "example:shacl12-grandfather": "npm run build --silent && node dist/examples/shacl12-grandfather/run.js",
    "example:transit-messages": "npm run build --silent && node dist/examples/transit-messages/run.js",
    "example:stateful-materialization": "npm run build --silent && node dist/examples/stateful-materialization/run.js --stateful-materialization",
    "test:transit-fleet": "npm run example:transit-fleet --silent > /tmp/owl2rl-transit-fleet-output.n3 && diff -u examples/transit-fleet/expected-output.n3 /tmp/owl2rl-transit-fleet-output.n3",
    "test:shipment-logistics": "npm run example:shipment-logistics --silent > /tmp/owl2rl-shipment-logistics-output.n3 && diff -u examples/shipment-logistics/expected-selected-output.n3 /tmp/owl2rl-shipment-logistics-output.n3",
    "test:skos-taxonomy": "npm run example:skos-taxonomy --silent > /tmp/skos-taxonomy-output.n3 && diff -u examples/skos-taxonomy/expected-selected-output.n3 /tmp/skos-taxonomy-output.n3",
    "test:owl-skos-catalog": "npm run example:owl-skos-catalog --silent > /tmp/owl-skos-catalog-output.n3 && diff -u examples/owl-skos-catalog/expected-selected-output.n3 /tmp/owl-skos-catalog-output.n3",
    "test:complex-path-coverage": "npm run example:complex-path-coverage --silent > /tmp/complex-path-coverage-output.n3 && diff -u examples/complex-path-coverage/expected-selected-output.n3 /tmp/complex-path-coverage-output.n3",
    "test:shacl-validation": "npm run example:shacl-validation --silent > /tmp/shacl-validation-output.n3 && diff -u examples/shacl-validation/expected-output.n3 /tmp/shacl-validation-output.n3",
    "test:shacl12-grandfather": "npm run example:shacl12-grandfather --silent > /tmp/shacl12-grandfather-output.n3 && diff -u examples/shacl12-grandfather/expected-output.n3 /tmp/shacl12-grandfather-output.n3",
    "test:transit-messages": "npm run example:transit-messages --silent > /tmp/transit-messages-output.nq && diff -u examples/transit-messages/expected-output.messages.nq /tmp/transit-messages-output.nq",
    "test:stateful-materialization": "npm run build --silent && node dist/examples/stateful-materialization/run.js > /tmp/stateful-materialization-stateless-output.nq && diff -u examples/stateful-materialization/expected-stateless-output.messages.nq /tmp/stateful-materialization-stateless-output.nq && node dist/examples/stateful-materialization/run.js --stateful-materialization > /tmp/stateful-materialization-stateful-output.nq && diff -u examples/stateful-materialization/expected-stateful-output.messages.nq /tmp/stateful-materialization-stateful-output.nq",
    "test:examples": "npm run test:transit-fleet && npm run test:shipment-logistics && npm run test:skos-taxonomy && npm run test:owl-skos-catalog && npm run test:complex-path-coverage && npm run test:shacl-validation && npm run test:shacl12-grandfather && npm run test:transit-messages && npm run test:stateful-materialization",
    "test:default-rules": "npm run build --silent && node dist/tests/run-default-rule-loading.js",
    "test:stateful-skolemization": "npm run build --silent && node dist/tests/run-stateful-skolemization.js",
    "test:marc-list-ontology": "npm run build --silent && node dist/tests/run-marc-list-ontology.js",
    "test:skos": "npm run build --silent && node dist/tests/run-skos-entailment.js",
    "test:shacl": "npm run build:node --silent && node dist/tests/run-shacl-core.js",
    "test:shacl12": "npm run build:node --silent && node dist/tests/run-shacl12-core.js",
    "test:owl:mobibench": "npm run build --silent && node dist/tests/run-mobibench-owl2rl.js",
    "test:owl:official": "npm run build --silent && node dist/tests/run-official-owl2rl.js",
    "test:owl": "npm run test:owl:mobibench && npm run test:owl:official",
    "test:mobibench": "npm run test:owl:mobibench",
    "test:official": "npm run test:owl:official",
    "test": "npm run test:default-rules && npm run test:stateful-skolemization && npm run test:marc-list-ontology && npm run test:skos && npm run test:owl",
    "perf": "npm run build:node --silent && node dist/perf/run.js",
    "perf:list": "npm run build:node --silent && node dist/perf/run.js --list"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pietercolpaert/rdfjs-inference-engine.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pietercolpaert/rdfjs-inference-engine/issues"
  },
  "homepage": "https://github.com/pietercolpaert/rdfjs-inference-engine#readme",
  "dependencies": {
    "@rdfjs/types": "^2.0.1",
    "eyeling": "^1.29.0",
    "rdf-parser-ts": "^0.2.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25.9.2",
    "adm-zip": "^0.5.17",
    "esbuild": "^0.28.0",
    "rdfxml-streaming-parser": "^3.2.0",
    "typescript": "^6.0.3"
  }
}
